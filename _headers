# Cloudflare Pages headers
# Ported from netlify.toml. Same rules, Pages syntax.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; img-src 'self' data:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Static assets are content-stable, so cache them hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML must revalidate or edits won't reach returning visitors.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/resume.pdf
  Cache-Control: public, max-age=3600
  Content-Disposition: inline; filename="Matthew-Donnell-Resume.pdf"
